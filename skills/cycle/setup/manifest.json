    { "role": "security_reviewer", "name": "cycle-v2-security-reviewer", "displayName": "Cycle Security Reviewer", "access": "read_only", "tools": ["read", "grep", "glob"], "mcpServers": [], "skills": [], "prompt": "../roles/security-reviewer.md" },
