{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cycle.mavis-setup-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pluginVersion", "profile", "agents", "status"],
  "properties": {
    "schema": { "const": "cycle.mavis-setup-receipt.v1" },
    "pluginVersion": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "enum": ["installed_unverified", "ready", "blocked", "uninstalled"] },
    "agents": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "nativeVerified", "effectiveModel", "modelSource", "hookDigest", "hookOfflineVerified", "hookLiveVerified"],
        "properties": {
          "role": { "enum": ["architect", "executor", "functional_reviewer", "security_reviewer", "arbiter"] },
          "name": { "type": "string", "pattern": "^cycle-v2-" },
          "nativeVerified": { "type": "boolean" },
          "effectiveModel": { "type": ["string", "null"] },
          "modelSource": { "enum": ["session-inherited", "native-agent"] },
          "hookDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "hookOfflineVerified": { "type": "boolean" },
          "hookLiveVerified": { "type": "boolean" }
        }
      }
    }
  }
}
