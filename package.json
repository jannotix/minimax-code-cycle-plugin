{
  "name": "minimax-code-cycle-plugin",
  "version": "2.0.0-alpha.7",
  "private": true,
  "description": "Production-candidate Cycle control plane for MiniMax Code with native multi-session coordination and evidence-gated delivery.",
  "type": "module",
  "author": "Gianluca Iannotta",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jannotix/minimax-code-cycle-plugin.git"
  },
  "homepage": "https://github.com/jannotix/minimax-code-cycle-plugin",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "npm run typecheck && npm run build && npm run test:run && npm run requirements:check && npm run sbom:check && npm run licenses:check && npm run secrets:check && npm run package:verify",
    "test": "npm run build && npm run test:run",
    "test:run": "node --test \"tests/*.test.mjs\" \"tests/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.tests.json --pretty false",
    "requirements:check": "node scripts/verify-requirements.mjs",
    "sbom": "node scripts/sbom.mjs",
    "sbom:check": "node scripts/sbom.mjs --check",
    "licenses": "node scripts/license-inventory.mjs",
    "licenses:check": "node scripts/license-inventory.mjs --check",
    "secrets:check": "node scripts/secret-scan.mjs",
    "package": "node scripts/package.mjs",
    "package:verify": "node scripts/supply-chain.mjs",
    "package:release": "node scripts/supply-chain.mjs --require-clean",
    "verify-audit": "node scripts/verify-audit.mjs",
    "inspect-ledger": "node scripts/inspect-ledger.mjs",
    "freeze-candidate": "node scripts/freeze-candidate.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
